# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/savitools

# Redis
REDIS_URL=redis://localhost:6379

# Stellar Network
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-rpc-testnet.stellar.org

# Contract Deployer (optional — required for Contract Deploy Helper tool)
# DEPLOYER_SECRET_KEY=

# CORS
WEB_ORIGIN=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Webhook Signing
WEBHOOK_SIGNING_SECRET=your-signing-secret-here

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api